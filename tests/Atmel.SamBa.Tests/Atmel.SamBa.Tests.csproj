<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net8.0-windows7.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Anp.Atmel.SamBa.Tests</RootNamespace>
    <AssemblyName>Atmel.SamBa.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Atmel.SamBa\Atmel.SamBa.csproj" />
  </ItemGroup>
  <!-- The net8.0 build resolves the library's portable target, which has no discovery surface and
       carries PortableSerialTransport instead of the Win32 transport; each test file compiles only
       where the types it tests exist. -->
  <!-- Removed files are re-added as None so they stay visible in Solution Explorer, which
       renders one TFM's evaluation. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0-windows7.0'">
    <Compile Remove="SamBaDeviceDiscoveryTests.cs" />
    <None Include="SamBaDeviceDiscoveryTests.cs" />
    <Compile Remove="SamBaDeviceWatcherTests.cs" />
    <None Include="SamBaDeviceWatcherTests.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows7.0'">
    <Compile Remove="PortableSerialTransportTests.cs" />
    <None Include="PortableSerialTransportTests.cs" />
  </ItemGroup>
</Project>
