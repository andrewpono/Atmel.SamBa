<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>

    <MajorVersion>1</MajorVersion>
    <MinorVersion>0</MinorVersion>
    <PatchVersion>0</PatchVersion>
    <!-- i.e. -beta.1 or empty -->
    <PreReleaseSuffix></PreReleaseSuffix>

    <!-- NuGet & informational version (SemVer) -->
    <Version>$(MajorVersion).$(MinorVersion).$(PatchVersion)$(PreReleaseSuffix)</Version>
    <!-- Binary compatibility version: keep stable for whole major -->
    <AssemblyVersion>$(MajorVersion).0.0.0</AssemblyVersion>
    <!-- File / diagnostic version (Windows "File version") -->
    <FileVersion>$(MajorVersion).$(MinorVersion).$(PatchVersion).0</FileVersion>
    <!-- Prevent SourceLink/SDK from appending +commitHash to the product version
         shown in Windows file properties and version output. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Prevent generation and copying of XML documentation files (e.g. for IntelliSense) -->
    <PublishDocumentationFiles>false</PublishDocumentationFiles>

    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>sambac</AssemblyName>
    <RootNamespace>Anp.Atmel.SamBa.Cli</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <!-- net48 resolves the library's Windows build, which carries VID/PID-filtered discovery;
       SAMBA_WIN32 compiles that auto-scan path here. net8.0 resolves the portable build (Windows
       included), which has no discovery surface of its own — auto-scan there calls
       SerialPort.GetPortNames() directly, unfiltered, every serial port on the machine. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <DefineConstants>$(DefineConstants);SAMBA_WIN32</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Atmel.SamBa\Atmel.SamBa.csproj" />
  </ItemGroup>
</Project>
