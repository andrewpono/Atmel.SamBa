<Window x:Class="Anp.Atmel.SamBa.Lite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:beh="clr-namespace:Anp.Atmel.SamBa.Lite.Behaviors"
        xmlns:viewModels="clr-namespace:Anp.Atmel.SamBa.Lite.ViewModels"
        xmlns:hex="clr-namespace:WpfHexaEditor;assembly=WPFHexaEditor"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Icon="/sambalite.ico"
        Width="562"
        MinWidth="600"
        Height="760"
        MinHeight="620"
        ResizeMode="CanResize"
        Background="{StaticResource PanelBackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel, IsDesignTimeCreatable=True}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ComboBoxSelectOverlay" TargetType="TextBlock">
            <Setter Property="Grid.ZIndex" Value="10"/>
            <Setter Property="Foreground" Value="{x:Static SystemColors.GrayTextBrush}"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Hidden"/>
            <Setter Property="Text" Value="-- Select Device --"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=SelectedItem}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=Items.Count}" Value="0">
                    <Setter Property="Text" Value="-- No Devices Found --"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextboxFileOverlay" TargetType="TextBlock">
            <Setter Property="Grid.ZIndex" Value="10"/>
            <Setter Property="Foreground" Value="{x:Static SystemColors.GrayTextBrush}"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Hidden"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding FirmwareFilePath}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding FirmwareFilePath}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RegionBoxOverlay" TargetType="TextBlock">
            <Setter Property="Grid.ZIndex" Value="10"/>
            <Setter Property="Foreground" Value="{x:Static SystemColors.GrayTextBrush}"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Hidden"/>
            <Setter Property="Text" Value="-- All --"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LockRegionsText}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LockRegionsText}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Bordered "0x" + borderless text box hex-address entry, shared by the tabs. -->
        <Style x:Key="HexEntryBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HexEntryPrefix" TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="HexEntryBox" TargetType="TextBox">
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MaxLength" Value="8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Read tab: the Size box is meaningless for a single-word read (fixed at 4 bytes), so
             it's disabled rather than removed, keeping the last-used size around. Verify doesn't
             touch Size; it compares against whatever the read produces. -->
        <Style x:Key="ReadSizeBox" TargetType="TextBox">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWordRead}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="MemoryViewRow" Height="*" MinHeight="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="LogViewRow" Height="*" MinHeight="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0" IsEnabled="{Binding IsNotBusy}">
            <MenuItem Header="_File">
                <MenuItem Header="Open FW _File..." Command="{Binding OpenFirmwareCommand}"
                          ToolTip="Select a firmware file to load" />
                <Separator />
                <MenuItem Header="Save View as _Binary..." Command="{Binding SaveViewBinaryCommand}"
                          ToolTip="Save the bytes shown in the memory view to a .bin file" />
                <MenuItem Header="Save View as _Text..." Command="{Binding SaveViewTextCommand}"
                          ToolTip="Save the bytes shown in the memory view as hex text (.txt or .csv)" />
                <Separator />
                <MenuItem Header="Open Settings _Location" Command="{Binding OpenSettingsLocationCommand}"
                          ToolTip="Open the folder containing the settings XML file" />
                <Separator />
                <MenuItem Header="_Save Log..." Command="{Binding SaveLogCommand}"
                          ToolTip="Save the current status log to a text file" />
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem.Resources>
                    <!-- Keep the Options menu open when toggling any item. -->
                    <Style TargetType="MenuItem">
                        <Setter Property="StaysOpenOnClick" Value="True" />
                    </Style>
                </MenuItem.Resources>
                <MenuItem Header="Enable _Watcher" IsCheckable="True" IsChecked="{Binding IsWatcherEnabled}"
                          ToolTip="Enable device watcher (event-driven plug/unplug detection)" />
                <MenuItem Header="Device _Filter" ToolTip="Which USB serial devices appear in the device list">
                    <MenuItem Header="Atmel SAM-BA (03EB:6124)" IsCheckable="True"
                              IsChecked="{Binding UseAtmelFilter}"
                              ToolTip="List only Atmel SAM-BA USB CDC devices (default)" />
                    <MenuItem IsCheckable="True" IsChecked="{Binding UseCustomFilter}"
                              ToolTip="Filter by a custom USB VID/PID (hex, up to 4 digits);&#x0a;leave a field blank to match any. Click a box to edit, or the row to select.">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="VID 0x" VerticalAlignment="Center" />
                                <TextBox Width="48" Margin="2,0,0,0" MaxLength="4"
                                         VerticalContentAlignment="Center"
                                         beh:HexInputBehavior.IsEnabled="True"
                                         PreviewMouseLeftButtonDown="HexBox_PreviewMouseLeftButtonDown"
                                         Text="{Binding CustomVendorIdHex}" />
                                <TextBlock Text="PID 0x" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <TextBox Width="48" Margin="2,0,0,0" MaxLength="4"
                                         VerticalContentAlignment="Center"
                                         beh:HexInputBehavior.IsEnabled="True"
                                         PreviewMouseLeftButtonDown="HexBox_PreviewMouseLeftButtonDown"
                                         Text="{Binding CustomProductIdHex}" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Header="Any device" IsCheckable="True" IsChecked="{Binding MatchAnyDevice}"
                              ToolTip="Ignore the VID/PID filter and list every serial port;&#x0a;use for Arduino / custom SAM boards. Device identity is confirmed on connect." />
                </MenuItem>
                <Separator />
                <MenuItem Header="Chip _Identification"
                          ToolTip="Which probe decides AT91SAM7/9 (legacy) vs. Cortex-M;&#x0a;Auto is right almost always - force only a part whose core is already known">
                    <MenuItem Header="Auto" IsCheckable="True" IsChecked="{Binding IdentifyAuto}"
                              ToolTip="Read the reset vector and take the branch it selects (default)" />
                    <MenuItem Header="Force ChipID (AT91SAM7/9)" IsCheckable="True"
                              IsChecked="{Binding IdentifyForceChipId}"
                              ToolTip="Skip the reset-vector read; go to the legacy CHIPID probe.&#x0a;Forcing this on a Cortex-M part hangs the SAM-BA monitor." />
                    <MenuItem Header="Force CpuID (Cortex-M)" IsCheckable="True"
                              IsChecked="{Binding IdentifyForceCpuId}"
                              ToolTip="Skip the reset-vector read; go to the Cortex-M CPUID probe.&#x0a;Forcing this on an AT91SAM7/9 part hangs the SAM-BA monitor." />
                </MenuItem>
                <MenuItem Header="Flash _Geometry Precedence"
                          ToolTip="Which account wins when the device's own reading disagrees with the table;&#x0a;Table is right unless the table row itself is known to be wrong">
                    <MenuItem Header="Table" IsCheckable="True" IsChecked="{Binding GeometryPrecedenceTable}"
                              ToolTip="Trust the datasheet-sourced table row on disagreement (default)" />
                    <MenuItem Header="Device" IsCheckable="True" IsChecked="{Binding GeometryPrecedenceDevice}"
                              ToolTip="Trust the device's own reading on disagreement.&#x0a;Only safe if the table row is known to be wrong for this part." />
                </MenuItem>
                <Separator />
                <MenuItem Header="Enable _Safe Mode" IsCheckable="True" IsChecked="{Binding IsSafeModeEnabled}"
                          ToolTip="Load the flash latch one word at a time instead of one batched transfer per page;&#x0a;slower, but robust with bootloaders that drop data mid-stream" />
                <Separator />
                <MenuItem Header="_Bytes per Line" ToolTip="Number of bytes shown per memory view row">
                    <MenuItem Header="4" IsCheckable="True" IsChecked="{Binding BytesPerLine4}" />
                    <MenuItem Header="8" IsCheckable="True" IsChecked="{Binding BytesPerLine8}" />
                    <MenuItem Header="16" IsCheckable="True" IsChecked="{Binding BytesPerLine16}" />
                </MenuItem>
                <MenuItem Header="Save With _Address" IsCheckable="True" IsChecked="{Binding SaveWithAddress}"
                          ToolTip="Prefix each line with its device address when saving the view as text" />
                <MenuItem Header="Show AS_CII" IsCheckable="True" IsChecked="{Binding ShowAscii}"
                          ToolTip="Show the ASCII column alongside the hex bytes in the memory view" />
                <Separator />
                <MenuItem StaysOpenOnClick="True" ToolTip="Maximum number of event log entries.">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <AccessText Text="Max _Log Entries" VerticalAlignment="Center" />
                            <TextBox Width="50" Text="{Binding MaxLogEntries}" Margin="6,0,0,0"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Maximum number of event log entries"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Show Supported _Chips" Command="{Binding ShowSupportedChipsCommand}"
              ToolTip="List all chip types this tool can flash" />
                <Separator />
                <MenuItem Header="_About" Command="{Binding ShowAboutCommand}"
                          ToolTip="Show the app and library version" />
            </MenuItem>
        </Menu>

        <!-- Device Selection -->
        <GroupBox Header="Device" Grid.Row="1" Margin="0,6,0,0" IsEnabled="{Binding IsNotBusy}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="DeviceComboBox" Margin="5" ItemsSource="{Binding DeviceList}"
                          SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayName"
                          ToolTip="Select a connected SAM-BA device">
                    <ComboBox.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                     RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Properties..." Command="{Binding ShowDevicePropertiesCommand}"
                                      ToolTip="Show properties for the selected device" />
                            <MenuItem Header="Refresh" Command="{Binding RefreshDevicesCommand}"
                                      ToolTip="Re-scan for SAM-BA devices" />
                        </ContextMenu>
                    </ComboBox.ContextMenu>
                </ComboBox>
                <TextBlock DataContext="{Binding ElementName=DeviceComboBox}" Padding="5,0"
                           Style="{StaticResource ComboBoxSelectOverlay}"/>
                <Button Grid.Column="1" Content="&#x27f3;" Padding="2,0" Margin="5" FontSize="18"
                        FontFamily="Arial" Command="{Binding RefreshDevicesCommand}"
                        ToolTip="Re-scan for SAM-BA devices" />
            </Grid>
        </GroupBox>

        <!-- Memory view -->
        <GroupBox Header="Memory View" Grid.Row="2" Margin="0,6,0,0">
            <hex:HexEditor x:Name="HexView" Margin="5" BorderThickness="0"
                           ReadOnlyMode="True"
                           AllowExtend="False"
                           AllowDeleteByte="False"
                           AllowFileDrop="False"
                           AllowZoom="True"
                           ByteGrouping="FourByte"
                           BytePerLine="{Binding BytesPerLine}"
                           OffsetBase="{Binding HexViewBaseAddress}"
                           OffSetPanelVisual="OffsetOnly"
                           StatusBarVisibility="Visible"
                           StringDataVisibility="{Binding ShowAscii, Converter={StaticResource BoolToVis}}"
                           ToolTip="Bytes read from device memory. Read-only; use the Read tab to load data." />
        </GroupBox>

        <GridSplitter x:Name="MemoryLogSplitter" Grid.Row="3" Height="2" HorizontalAlignment="Stretch"
                      Margin="0,3" ShowsPreview="True" Background="DarkBlue" ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows" DragCompleted="MemoryLogSplitter_DragCompleted" />

        <!-- Status Log -->
        <GroupBox Header="Log" Grid.Row="4">
            <Grid Margin="0,6,0,0">
                <ListBox ItemsSource="{Binding LogEntries}" BorderThickness="0"
                         SelectionMode="Extended" beh:AutoScrollToBottomBehavior.IsEnabled="True"
                         beh:CopySelectedItemsBehavior.Command="{Binding CopySelectedLogCommand}"
                         beh:DeselectOnEmptyClickBehavior.IsEnabled="True">
                    <ListBox.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                     RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Copy" ToolTip="Copy selected status messages to clipboard"
                                      Command="{Binding CopySelectedLogCommand}" InputGestureText="Ctrl+C"
                                      CommandParameter="{Binding PlacementTarget.SelectedItems,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Clear" ToolTip="Clear all status messages"
                                      Command="{Binding ClearLogCommand}" InputGestureText="Del"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding ClearLogCommand}" />
                    </ListBox.InputBindings>
                </ListBox>
            </Grid>
        </GroupBox>

        <!-- Operations -->
        <TabControl Grid.Row="5" Margin="0,6,0,0" IsEnabled="{Binding IsNotBusy}" 
                    Background="Transparent" SelectedIndex="{Binding SelectedTabIndex}">

            <!-- Read -->
            <TabItem Header="Read">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Content="Address:" VerticalAlignment="Center" Padding="0"
                           Margin="0,0,6,0" />
                    <Border Grid.Column="1" Style="{StaticResource HexEntryBorder}">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="0x" Style="{StaticResource HexEntryPrefix}" />
                            <TextBox Style="{StaticResource HexEntryBox}"
                                     Text="{Binding ReadAddressHex, UpdateSourceTrigger=PropertyChanged,
                                            ValidatesOnDataErrors=True}"
                                     beh:HexInputBehavior.IsEnabled="True"
                                     ToolTip="Start address to read from (hex)">
                                <TextBox.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                 RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Flash Base"
                                                  Command="{Binding SetReadAddressToFlashBaseCommand}"
                                                  ToolTip="Set to the identified chip's flash base address" />
                                    </ContextMenu>
                                </TextBox.ContextMenu>
                            </TextBox>
                        </StackPanel>
                    </Border>

                    <CheckBox Grid.Column="2" Content="_Word" VerticalAlignment="Center" Margin="12,0,0,0"
                              IsChecked="{Binding IsWordRead}" VerticalContentAlignment="Center"
                              ToolTip="Read a single 32-bit word instead of a block (the right choice&#x0a;for peripheral registers); shown in the memory view either way." />

                    <CheckBox Grid.Column="3" Content="V_erify..." VerticalAlignment="Center" Margin="8,0,0,0"
                              IsChecked="{Binding IsVerifyRead}" VerticalContentAlignment="Center"
                              ToolTip="Read prompts for a binary file first, then compares it&#x0a;against the bytes just read (block or word, either way)." />

                    <Label Grid.Column="4" Content="Size:" VerticalAlignment="Center" Margin="12,0,6,0"
                           Padding="0" />
                    <TextBox Grid.Column="5" MinWidth="70" VerticalAlignment="Center" MaxLength="8"
                             Style="{StaticResource ReadSizeBox}"
                             Text="{Binding ReadSizeText, UpdateSourceTrigger=PropertyChanged,
                                    ValidatesOnDataErrors=True}"
                             ToolTip="Number of bytes to read (decimal)" />

                    <Button Grid.Column="7" Content="_Read" Style="{StaticResource TabButton}"
                            Command="{Binding ReadCommand}"
                            ToolTip="Read the address into the memory view (a block, or a single&#x0a;word when Word is checked); Verify then compares it to a file" />
                </Grid>
            </TabItem>

            <!-- Write -->
            <TabItem Header="Write">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Content="Address:" VerticalAlignment="Center" Padding="0"
                           Margin="0,0,6,0" />
                    <Border Grid.Column="1" Style="{StaticResource HexEntryBorder}">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="0x" Style="{StaticResource HexEntryPrefix}" />
                            <TextBox Style="{StaticResource HexEntryBox}"
                                     Text="{Binding WriteAddressHex, UpdateSourceTrigger=PropertyChanged,
                                            ValidatesOnDataErrors=True}"
                                     beh:HexInputBehavior.IsEnabled="True"
                                     ToolTip="Start address to write to (hex)">
                                <TextBox.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                 RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Flash Base"
                                                  Command="{Binding SetWriteAddressToFlashBaseCommand}"
                                                  ToolTip="Set to the identified chip's flash base address" />
                                    </ContextMenu>
                                </TextBox.ContextMenu>
                            </TextBox>
                        </StackPanel>
                    </Border>

                    <Label Grid.Column="2" Content="Word:" VerticalAlignment="Center" Margin="12,0,6,0"
                           Padding="0" />
                    <Border Grid.Column="3" Style="{StaticResource HexEntryBorder}">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="0x" Style="{StaticResource HexEntryPrefix}" />
                            <TextBox Style="{StaticResource HexEntryBox}"
                                     Text="{Binding WriteWordHex, UpdateSourceTrigger=PropertyChanged,
                                            ValidatesOnDataErrors=True}"
                                     beh:HexInputBehavior.IsEnabled="True"
                                     ToolTip="32-bit word to write (hex), written as one bus word access,&#x0a;the right form for RAM and peripheral registers.&#x0a;Use Write File or Update FW for flash." />
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="4" Content="Write _Word" Style="{StaticResource TabButton}"
                            Margin="12,0,0,0" Command="{Binding WriteWordCommand}"
                            ToolTip="Write the word to the address (single word bus access)" />

                    <Button Grid.Column="6" Content="Write _File..." Style="{StaticResource TabButton}"
                            Command="{Binding WriteFileCommand}"
                            ToolTip="Write a binary file at the address. Ranges inside flash are page-programmed&#x0a;(partial pages read-modify-write); other writable memory is written directly." />
                </Grid>
            </TabItem>

            <!-- Lock -->
            <TabItem Header="Lock">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Content="_Regions:" VerticalAlignment="Center" Padding="0"
                           Target="{Binding ElementName=LockRegionsBox}" />
                    <Grid Grid.Column="1" Width="120" Margin="6,0,0,0">
                        <TextBox x:Name="LockRegionsBox" VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding LockRegionsText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Region list like 0-3, 8 (leave empty for all regions)" />
                        <TextBlock Style="{StaticResource RegionBoxOverlay}" />
                    </Grid>

                    <Button Grid.Column="2" Content="_Lock" Style="{StaticResource TabButton}"
                            Margin="12,0,0,0" Command="{Binding LockAllCommand}"
                            ToolTip="Lock the listed regions (all regions when the list is empty)" />
                    <Button Grid.Column="3" Content="_Unlock" Style="{StaticResource TabButton}"
                            Margin="8,0,0,0" Command="{Binding UnlockAllCommand}"
                            ToolTip="Unlock the listed regions (all regions when the list is empty)" />

                    <Button Grid.Column="6" Content="_Display" Style="{StaticResource TabButton}"
                            Command="{Binding DisplayLockRegionsCommand}"
                            ToolTip="Log which lock regions are currently locked" />
                </Grid>
            </TabItem>

            <!-- Go -->
            <TabItem Header="Go">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Content="Address:" VerticalAlignment="Center"
                           Padding="0" Margin="0,0,6,0" />
                    <Border Grid.Column="1" Style="{StaticResource HexEntryBorder}">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="0x" Style="{StaticResource HexEntryPrefix}" />
                            <TextBox Style="{StaticResource HexEntryBox}"
                                     Text="{Binding GoAddressHex, UpdateSourceTrigger=PropertyChanged,
                                            ValidatesOnDataErrors=True}"
                                     beh:HexInputBehavior.IsEnabled="True"
                                     ToolTip="Address to jump to (hex)">
                                <TextBox.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                 RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Flash Base"
                                                  Command="{Binding SetGoAddressToFlashBaseCommand}"
                                                  ToolTip="Set to the identified chip's flash base address" />
                                    </ContextMenu>
                                </TextBox.ContextMenu>
                            </TextBox>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="2" Content="_Go" Margin="12,0,0,0"
                            Style="{StaticResource TabButton}" Command="{Binding GoCommand}"
                            ToolTip="Jump to the address and execute (address is not aligned, odd for Thumb);&#x0a;the device may hang" />
                    <Label Grid.Column="3" Content="Jump may hang the device!" VerticalAlignment="Center"
                           Foreground="Red" Padding="0" Margin="10,0,6,0" />
                </Grid>
            </TabItem>

            <!-- Info -->
            <TabItem Header="Info">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Device Properties" Style="{StaticResource TabButton}"
                            Command="{Binding ShowDevicePropertiesCommand}"
                            ToolTip="Show selected SAM-BA device properties" />
                    <Button Grid.Column="1" Content="Chip Info" Style="{StaticResource TabButton}" Margin="8,0,0,0"
                            Command="{Binding ShowChipInfoCommand}"
                            ToolTip="Try to read and show selected device chip info" />
                    <Button Grid.Column="2" Content="Device Status" Style="{StaticResource TabButton}" Margin="8,0,0,0"
                            Command="{Binding ShowDeviceStatusCommand}"
                            ToolTip="Log boot source, security bit, locked regions and unique id" />
                </Grid>
            </TabItem>

            <!-- Misc -->
            <TabItem Header="Misc.">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Boot from Flash" Style="{StaticResource TabButton}"
                            Command="{Binding BootFromFlashCommand}"
                            ToolTip="Set the boot bit so the chip boots from flash. May block further SAM-BA access" />
                    <Button Grid.Column="1" Content="Boot from ROM" Style="{StaticResource TabButton}" Margin="8,0,0,0"
                            Command="{Binding BootFromRomCommand}"
                            ToolTip="Clear the boot bit so the chip boots the ROM SAM-BA monitor" />
                    <Button Grid.Column="2" Content="Set Security" Style="{StaticResource TabButton}" Margin="8,0,0,0"
                            Command="{Binding SetSecurityCommand}"
                            ToolTip="Set the security bit. Irreversible: blocks further SAM-BA access;&#x0a;only the ERASE pin recovers the part" />
                    <Button Grid.Column="3" Content="Erase All Flash" Style="{StaticResource TabButton}" Margin="8,0,0,0"
                            Command="{Binding EraseCommand}"
                            ToolTip="Erase entire device flash" />
                    <Button Grid.Column="5" Content="Rese_t" Style="{StaticResource TabButton}"
                            Command="{Binding ResetCommand}"
                            ToolTip="Reset the CPU (the device re-enumerates afterwards)" />
                </Grid>
            </TabItem>

            <!-- Update FW -->
            <TabItem Header="Update FW">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox Text="{Binding FirmwareFilePath, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" AllowDrop="True"
                                     beh:FileDropBehavior.FileDropCommand="{Binding FirmwareFileDroppedCommand}"
                                     ToolTip="Firmware file path (drag and drop accepted)" />
                            <TextBlock Text="-- Select FW file --" Foreground="#FF8A8A8A" Margin="5,0,0,0"
                                       Style="{StaticResource TextboxFileOverlay}" />
                        </Grid>

                        <Button Grid.Column="1" Content="&#x2026;" Padding="4,0,4,0" Margin="10,0,0,0"
                                FontFamily="Arial" VerticalAlignment="Center"
                                Command="{Binding OpenFirmwareCommand}"
                                ToolTip="Browse for a firmware file" Height="18" />
                    </Grid>

                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,10,0,0">
                        <Label Content="Offset:" VerticalAlignment="Center" Padding="0" Margin="0,0,6,0"
                               ToolTip="Where in flash to write the image, relative to the flash base (hex)" />
                        <Border Grid.Column="1" Style="{StaticResource HexEntryBorder}" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <Label Content="0x" Style="{StaticResource HexEntryPrefix}" />
                                <TextBox Style="{StaticResource HexEntryBox}"
                                         Text="{Binding FwOffsetHex, UpdateSourceTrigger=PropertyChanged,
                                         ValidatesOnDataErrors=True}"
                                         beh:HexInputBehavior.IsEnabled="True"
                                         ToolTip="Offset into flash to write the image at (hex)">
                                </TextBox>
                            </StackPanel>
                        </Border>

                        <Label Content="Lock After Write:" VerticalAlignment="Center" Padding="0" Margin="0,0,6,0"
                               ToolTip="Which flash lock regions to lock after the update" />
                        <ComboBox ItemsSource="{Binding LockScopeValues}" SelectedItem="{Binding FwLockScope}"
                                  MinWidth="70" VerticalAlignment="Center" Margin="0,0,14,0"
                                  ToolTip="None: leave alone. Written: image regions. All: every region" />
                    </StackPanel>

                    <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Content="_Update" Padding="6"
                            MinWidth="50" Margin="12,0,0,0" Style="{StaticResource PrimaryButton}"
                            d:Command="{x:Null}" Command="{Binding UpdateFirmwareCommand}"
                            ToolTip="Update the FW on the chip" />
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <CheckBox Content="Unlock Before Write" IsChecked="{Binding AutoUnlock}" Margin="0,0,14,0"
                                  VerticalAlignment="Center"
                                  ToolTip="Unlock any locked flash regions before erase/write, so programming a&#x0a;locked part doesn't fail with a lock error (default on)" />
                        <CheckBox Content="Erase All" IsChecked="{Binding FwEraseAll}" Margin="0,0,14,0"
                                  VerticalAlignment="Center"
                                  ToolTip="Erase the entire flash before programming.&#xA;If data is also stored in flash it'll be gone" />
                        <CheckBox Content="Verify" IsChecked="{Binding FwVerify}" Margin="0,0,14,0"
                                  VerticalAlignment="Center"
                                  ToolTip="Verify flash contents against the supplied FW file" />
                        <CheckBox Content="Boot to Flash" IsChecked="{Binding FwBootToFlash}" Margin="0,0,14,0"
                                  VerticalAlignment="Center"
                                  ToolTip="Set the boot bit so the chip boots the updated FW from flash" />
                        <CheckBox Content="Security" IsChecked="{Binding FwSecurity}" Margin="0,0,14,0"
                                  VerticalAlignment="Center"
                                  ToolTip="Set the security bit after programming to prevent external access.&#xA;Once set, only the ERASE pin can clear it" />
                        <CheckBox Content="Reset" IsChecked="{Binding FwResetAfterLoad}"
                                  VerticalAlignment="Center"
                                  ToolTip="Reset the CPU after programming" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Progress -->
        <Grid Grid.Row="6" Margin="0,10,0,0">
            <ProgressBar Height="22" Minimum="0"
                         Maximum="{Binding ProgressMaximum}"
                         Value="{Binding ProgressValue, Mode=OneWay}"
                         IsIndeterminate="{Binding IsProgressIndeterminate}" />

            <TextBlock Text="{Binding ProgressMessage}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" FontWeight="SemiBold" />
        </Grid>
    </Grid>
</Window>
