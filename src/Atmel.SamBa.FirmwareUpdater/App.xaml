<Application x:Class="Anp.Atmel.SamBa.FirmwareUpdater.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Anp.Atmel.SamBa.FirmwareUpdater.Converters">
    <Application.Resources>
        <ResourceDictionary>
            
            <Color x:Key="AccentColor">DarkOrchid</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="GroupBoxBorderBrush" Color="#D0D0D0" />

            <!-- Accent-colored primary buttons -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <!--<Setter Property="BorderThickness" Value="0" />-->
            </Style>

            <!-- Consistent GroupBox appearance -->
            <Style TargetType="GroupBox">
                <Setter Property="BorderBrush" Value="{StaticResource GroupBoxBorderBrush}" />
            </Style>

            <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
